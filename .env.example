# ---- Database (Turso / libSQL) ----
# Create a database at https://turso.tech (free tier) then run:
#   turso db show <name> --url          -> TURSO_DATABASE_URL
#   turso db tokens create <name>       -> TURSO_AUTH_TOKEN
# For local dev you may instead use a file: TURSO_DATABASE_URL="file:local.db"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Media storage (Vercel Blob) ----
# Create a Blob store in the Vercel dashboard (Storage tab). On Vercel this is
# injected automatically; set it locally only for local uploads.
BLOB_READ_WRITE_TOKEN=

# ---- Admin authentication ----
# Password for the single admin/owner sign-in at /admin
ADMIN_PASSWORD=
# Random secret (>= 16 chars) used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=
# Optional display/notification email for the admin identity
ADMIN_EMAIL=

# ---- Email notifications (optional, Resend) ----
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# Public site URL used for SEO (canonical, sitemap, robots, JSON-LD).
# On Vercel this auto-falls back to the deployment URL, but set your real
# domain here for correct canonical tags, e.g. https://mobilityone.in
NEXT_PUBLIC_SITE_URL=
